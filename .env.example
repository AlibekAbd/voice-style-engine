# Скопировать в .env и заполнить. Файл .env под гитигнором.
# Ключ Gemini — для всего, что стоит денег (voice.analyse).
GEMINI_API_KEY=
# Телеграм — только для выгрузки переписки (voice.collect). Сессия
# создаётся при первом запуске и живёт в session/, тоже под гитигнором.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
